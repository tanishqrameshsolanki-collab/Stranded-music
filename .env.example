# === Vercel Frontend Environment Variables ===

# Railway API Backend URL (no trailing slash)
# Set this in Vercel Dashboard > Project > Settings > Environment Variables
VITE_API_URL=https://your-railway-api.up.railway.app

# Gemini API Key (for AI features, if any)
GEMINI_API_KEY=

# Note: Supabase URL and anon key are hardcoded in services/supabase.ts
# If you need to change them, update that file directly.
